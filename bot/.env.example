# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- GHL (GoHighLevel) ---
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_ONBOARDING_WEBHOOK=

# --- Channels (Discord channel IDs) ---
CHANNEL_DAILY_BRIEFING=
CHANNEL_WEEKLY_AUDIT=
CHANNEL_OUTREACH=
CHANNEL_ONBOARDING=
CHANNEL_CONTENT_VALDES=

# --- Gate 5 (content approval + posting) ---
# Composio API key — posting layer (LinkedIn v1). The connection ID lives in
# config/brands/valdes.yaml accounts.linkedin.composio_connection_id.
COMPOSIO_API_KEY=
# Persistent state dir. Railway: /data (volume mount). Local default: ./state
# STATE_DIR=/data
# Brendan's Discord user ID — only this user's reactions approve drafts.
# Unset = falls back to the guild owner.
# APPROVER_USER_ID=

# --- Model overrides (optional, defaults shown) ---
# MODEL_BRIEF=claude-sonnet-4-6
# MODEL_AUDIT=claude-opus-4-6
# MODEL_OUTREACH=claude-sonnet-4-6

# --- Paths (optional, defaults shown) ---
# Skills + leads are bundled into bot/data/ at build time by scripts/bundle-data.mjs
# Override only if you're running with externally mounted skill files.
# SKILLS_DIR=data/skills
# LEADS_FILE=data/leads/vegas-pool-leads.md

# --- Railway ---
PORT=3000
