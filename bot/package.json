{
  "name": "rocco-bot",
  "version": "1.0.0",
  "description": "ROCCO — Valdes Agency operational Discord bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node scripts/bundle-data.mjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node scripts/bundle-data.mjs && tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "discord.js": "^14.16.3",
    "node-cron": "^3.0.3",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
