{
  "enabledPlugins": {
    "core-3d-animation@claude-design-skillstack": true,
    "animation-components@claude-design-skillstack": true,
    "authoring-motion@claude-design-skillstack": true,
    "extended-3d-scroll@claude-design-skillstack": true,
    "meta-skills@claude-design-skillstack": true,
    "brightdata-plugin@brightdata-plugins": true,
    "brightdata-plugin@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "test -d memory/obsidian && find memory/obsidian -maxdepth 1 -type f -name '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.md' -print0 | sort -z | xargs -0 -r -I{} sh -c 'echo \"--- {} ---\"; cat \"{}\"; echo' || true"
          }
        ]
      }
    ]
  }
}
